# Backend API Base URL
# Local Development: http://localhost:5000/api
# Production Hosting (e.g. Render / Railway): https://<your-backend-app-name>.onrender.com/api
# Note: Vite environment variables MUST start with 'VITE_' to be embedded at build time.
VITE_API_URL=http://localhost:5000/api
